{
  "hooks": {
    "sessionStart": [
      {
        "command": "npx -y @evalon-ai/agent-hook@1.0.3 --runner cursor"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "npx -y @evalon-ai/agent-hook@1.0.3 --runner cursor"
      }
    ],
    "preToolUse": [
      {
        "command": "npx -y @evalon-ai/agent-hook@1.0.3 --runner cursor"
      }
    ],
    "postToolUse": [
      {
        "command": "npx -y @evalon-ai/agent-hook@1.0.3 --runner cursor"
      }
    ],
    "postToolUseFailure": [
      {
        "command": "npx -y @evalon-ai/agent-hook@1.0.3 --runner cursor"
      }
    ],
    "subagentStart": [
      {
        "command": "npx -y @evalon-ai/agent-hook@1.0.3 --runner cursor"
      }
    ],
    "subagentStop": [
      {
        "command": "npx -y @evalon-ai/agent-hook@1.0.3 --runner cursor"
      }
    ],
    "stop": [
      {
        "command": "npx -y @evalon-ai/agent-hook@1.0.3 --runner cursor"
      }
    ]
  }
}
