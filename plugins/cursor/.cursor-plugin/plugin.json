{
  "name": "ev-ai-agent-hooks",
  "version": "1.3.7",
  "description": "Layer-3 runtime telemetry hooks (observe-only, fail-open).",
  "author": {
    "name": "ev-ai",
    "email": "platform@ev.ai"
  },
  "license": "Proprietary",
  "keywords": [
    "ev-ai",
    "runtime",
    "telemetry",
    "hooks"
  ],
  "hooks": "./hooks/hooks.json",
  "variables": {
    "type": "object",
    "properties": {
      "COLLECTOR_URL": {
        "type": "string",
        "title": "Collector URL",
        "description": "ev-ai collector URL (https://<collector-host>/<orgToken>/hook). Cursor exports it to every hook as COLLECTOR_URL."
      }
    },
    "required": [
      "COLLECTOR_URL"
    ]
  }
}
