{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "sh ./launcher.sh --runner cursor"
      },
      {
        "command": "powershell -NoProfile -NonInteractive -Command \"& ([scriptblock]::Create((Get-Content -Raw -LiteralPath (Join-Path $env:CURSOR_PLUGIN_ROOT 'launcher.ps1')))) --runner cursor\""
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "sh ./launcher.sh --runner cursor"
      },
      {
        "command": "powershell -NoProfile -NonInteractive -Command \"& ([scriptblock]::Create((Get-Content -Raw -LiteralPath (Join-Path $env:CURSOR_PLUGIN_ROOT 'launcher.ps1')))) --runner cursor\""
