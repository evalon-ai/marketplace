{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '\"${PLUGIN_ROOT}/launcher.sh\" --runner codex; exit 0'",
            "commandWindows": "powershell -NoProfile -NonInteractive -Command \"& ([scriptblock]::Create((Get-Content -Raw -LiteralPath (Join-Path (Get-Item Env:PLUGIN_ROOT).Value 'launcher.ps1')))) --runner codex\" ; exit 0",
            "statusMessage": "ev-ai runtime report"
          }
        ]
      }
    ],
